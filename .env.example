# VAISASTRAM — Governed Autonomous AI Agents
# Environment Configuration Template

# Inference Mode: hybrid (local Ollama with cloud fallback), local (strictly local), or cloud (cloud-only)
AI_PROVIDER_MODE=hybrid

# Whether to fallback to cloud providers (Gemini, Groq) when local Ollama inference fails
AI_CLOUD_FALLBACK_ENABLED=true

# Local Ollama Inference (Gemma 3 4B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=5m

# Primary Cloud Provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Secondary Cloud Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Default AI Request Timeout in Seconds
AI_REQUEST_TIMEOUT=90
