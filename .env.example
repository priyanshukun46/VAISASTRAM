# VAISASTRAM — Governed Autonomous AI Agents
# Environment Configuration Template

# Inference Mode (defaults: "cloud" in production, "hybrid" in development): hybrid, local, or cloud
AI_PROVIDER_MODE=hybrid

# Provider Selection Strategy
# AI_PRIMARY_PROVIDER: openai, gemini, grok, groq, ollama
# AI_FALLBACK_PROVIDER: grok, groq, gemini, openai
# AI_FALLBACK_ENABLED: true or false
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=grok
AI_FALLBACK_ENABLED=true
AI_CLOUD_FALLBACK_ENABLED=true

# OpenAI Configuration
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o
OPENAI_ENABLED=true

# xAI (Grok) Configuration
XAI_API_KEY=your_xai_key
XAI_MODEL=grok-2-latest
XAI_ENABLED=true

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.8-flash

# Groq Configuration
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Inference (Gemma 3 4B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=5m

# Default AI Request Timeout in Seconds
AI_REQUEST_TIMEOUT=90
