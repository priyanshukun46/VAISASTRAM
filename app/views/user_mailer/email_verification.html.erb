<h2 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-top: 0;">Verify your VAISASTRAM Email Address</h2>

<p style="color: #334155; font-size: 14px; margin-bottom: 20px;">
  Hello <%= @user.name %>, please confirm that this email address belongs to your VAISASTRAM account by clicking the verification button below.
</p>

<p style="text-align: center; margin: 28px 0;">
  <%= link_to "Verify Email Address", verify_email_url(token: @token), class: "button btn-accent" %>
</p>

<div class="card-box">
  <p style="font-size: 12px; color: #64748b; margin: 0;">
    If the button above does not work, copy and paste this link into your browser:
    <br>
    <span style="font-family: monospace; word-break: break-all; color: #0f172a;"><%= verify_email_url(token: @token) %></span>
  </p>
</div>

<div class="security-notice">
  <strong>Security Notice:</strong> This verification token is valid for 24 hours. If you did not request this verification, please contact your security auditor immediately.
</div>
