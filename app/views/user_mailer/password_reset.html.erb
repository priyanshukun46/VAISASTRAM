<h2 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-top: 0;">Password Reset Request</h2>

<p style="color: #334155; font-size: 14px; margin-bottom: 20px;">
  Hello <%= (@user || @resource)&.name || "Operator" %>, a request was received to reset the password for your VAISASTRAM account (<%= (@user || @resource)&.email %>).
</p>

<p style="text-align: center; margin: 28px 0;">
  <%= link_to "Reset Password", edit_password_url(@user || @resource, reset_password_token: @token), class: "button btn-accent" %>
</p>

<div class="card-box">
  <p style="font-size: 12px; color: #64748b; margin: 0;">
    If you did not request this password reset, please ignore this email. Your password will remain unchanged.
    <br><br>
    Direct link:
    <br>
    <span style="font-family: monospace; word-break: break-all; color: #0f172a;"><%= edit_password_url(@user || @resource, reset_password_token: @token) %></span>
  </p>
</div>

<div class="security-notice">
  <strong>Security Notice:</strong> This password reset link will expire in accordance with Devise security policy. Do not share this link with anyone.
</div>
