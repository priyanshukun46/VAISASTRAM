<h2 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-top: 0;">Password Reset Instructions</h2>

<p style="color: #334155; font-size: 14px; margin-bottom: 20px;">
  Hello <%= (@resource || @user)&.name || "Operator" %>, someone has requested a link to change your password on VAISASTRAM.
</p>

<p style="text-align: center; margin: 28px 0;">
  <%= link_to "Change my password", edit_password_url(@resource || @user, reset_password_token: @token), class: "button btn-accent" %>
</p>

<div class="card-box">
  <p style="font-size: 12px; color: #64748b; margin: 0;">
    If you didn't request this, please ignore this email. Your password won't change until you access the link above and create a new one.
    <br><br>
    Direct link:
    <br>
    <span style="font-family: monospace; word-break: break-all; color: #0f172a;"><%= edit_password_url(@resource || @user, reset_password_token: @token) %></span>
  </p>
</div>
