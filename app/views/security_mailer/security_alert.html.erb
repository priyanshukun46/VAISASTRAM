<h2 style="font-size: 20px; font-weight: 800; color: #dc2626; margin-top: 0;">Important Security Alert</h2>

<p style="color: #334155; font-size: 14px; margin-bottom: 20px;">
  A critical security or governance event has been recorded by the VAISASTRAM platform.
</p>

<div class="card-box">
  <table style="width: 100%; font-size: 13px; color: #334155;">
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b; width: 140px;">Alert Type:</td>
      <td style="padding: 6px 0; font-weight: bold; color: #dc2626;"><%= @details["type"] || @details[:type] || "GOVERNANCE_SECURITY_EVENT" %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b;">Description:</td>
      <td style="padding: 6px 0; color: #0f172a;"><%= @details["message"] || @details[:message] || @details["description"] || @details[:description] || "Suspicious or non-compliant activity detected" %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b;">Occurred At:</td>
      <td style="padding: 6px 0; font-family: monospace;"><%= @occurred_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></td>
    </tr>
    <% if @details["action_fingerprint"].present? || @details[:action_fingerprint].present? %>
      <tr>
        <td style="padding: 6px 0; font-weight: 600; color: #64748b;">Fingerprint:</td>
        <td style="padding: 6px 0; font-family: monospace; font-size: 11px;"><%= @details["action_fingerprint"] || @details[:action_fingerprint] %></td>
      </tr>
    <% end %>
  </table>
</div>

<p style="text-align: center; margin: 28px 0;">
  <%= link_to "Review Audit Stream", audit_url, class: "button btn-accent" %>
</p>

<div class="security-notice">
  <strong>Audit Notice:</strong> This event was logged with hash chaining into the PostgreSQL append-only audit trail for compliance verification.
</div>
