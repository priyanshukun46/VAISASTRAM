<%= turbo_stream.replace "integrity_verification_banner" do %>
  <div id="integrity_verification_banner" class="p-5 rounded-2xl <%= @verification_result.valid? ? 'bg-[#0d0726] border-emerald-500' : 'bg-rose-950 border-rose-500' %> text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm border-2">
    <div class="flex items-start space-x-3.5">
      <div class="p-2.5 rounded-xl <%= @verification_result.valid? ? 'bg-emerald-500/20 text-[#d4f90d]' : 'bg-rose-500/20 text-rose-300' %> shrink-0">
        <% if @verification_result.valid? %>
          <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        <% else %>
          <svg class="w-6 h-6 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        <% end %>
      </div>
      <div>
        <div class="text-xs font-black uppercase tracking-wider <%= @verification_result.valid? ? 'text-[#d4f90d]' : 'text-rose-300' %> flex items-center space-x-2">
          <span><%= @verification_result.valid? ? 'Ledger Verification Passed: All Links Cryptographically Valid' : 'Ledger Integrity Failure Detected' %></span>
          <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-white/20 text-white">SHA-256</span>
        </div>
        <div class="text-xs text-slate-300 mt-1">
          Chain: <span class="font-mono text-white"><%= @verification_result.chain_id %></span> · Verified <span class="font-bold text-white"><%= @verification_result.verified_count %> of <%= @verification_result.total_events %></span> events with zero tamper.
        </div>
      </div>
    </div>
    <div class="sm:shrink-0">
      <%= button_to verify_audit_path, method: :post, class: "inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-900 text-xs font-mono font-bold uppercase tracking-wider transition cursor-pointer shadow-xs" do %>
        <span>Re-verify</span>
      <% end %>
    </div>
  </div>
<% end %>
