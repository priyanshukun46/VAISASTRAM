<div id="flash_messages" class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-4">
  <% n_msg = defined?(notice) && notice.present? ? notice : (flash[:notice] rescue nil) %>
  <% if n_msg.present? %>
    <div class="flex items-center justify-between p-3.5 mb-4 text-xs font-medium rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-900 shadow-2xs" role="alert">
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span><%= n_msg %></span>
      </div>
    </div>
  <% end %>

  <% a_msg = defined?(alert) && alert.present? ? alert : (flash[:alert] rescue nil) %>
  <% if a_msg.present? %>
    <div class="flex items-center justify-between p-3.5 mb-4 text-xs font-medium rounded-lg bg-rose-50 border border-rose-300 text-rose-900 shadow-2xs" role="alert">
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span><%= a_msg %></span>
      </div>
    </div>
  <% end %>
</div>
