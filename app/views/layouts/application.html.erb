<!DOCTYPE html>
<html class="h-full bg-[#f4f3ef] text-slate-900">
  <head>
    <title><%= content_for(:title) || "VAISASTRAM — Governed Autonomous AI Agent Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="VAISASTRAM">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col font-sans antialiased selection:bg-[#d4f90d] selection:text-black bg-[#f4f3ef]">
    <% if devise_controller? %>
      <!-- Clean full-screen auth layout (split-screen) -->
      <% if alert = flash[:alert] %>
        <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-md w-full px-4">
          <div class="flex items-center space-x-2 p-3 text-xs rounded-lg bg-rose-50 border border-rose-300 text-rose-900 shadow-lg">
            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span><%= alert %></span>
          </div>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-md w-full px-4">
          <div class="flex items-center space-x-2 p-3 text-xs rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-900 shadow-lg">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span><%= notice %></span>
          </div>
        </div>
      <% end %>

      <%= yield %>
    <% else %>
      <!-- Standard Governed Application Layout (matches UX Pilot Reference Style) -->
      <header class="sticky top-0 z-50 bg-[#f4f3ef]/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <!-- Brand & Mascot Logo -->
            <div class="flex items-center space-x-6">
              <%= link_to root_path, class: "flex items-center space-x-2.5 group" do %>
                <%= vaisastram_mascot_svg(classes: "w-8 h-8", variant: :dark) %>
                <div>
                  <div class="flex items-center space-x-2">
                    <span class="text-lg font-black tracking-tight text-[#0d0726] font-sans">VAISASTRAM</span>
                    <span class="text-[9px] font-mono uppercase tracking-widest px-1.5 py-0.5 rounded bg-[#0d0726] text-white">2.0</span>
                  </div>
                  <div class="text-[10px] font-mono text-slate-500">AI proposes · Ruby decides</div>
                </div>
              <% end %>
            </div>

            <!-- Central Navigation Links -->
            <% if user_signed_in? %>
              <nav class="hidden md:flex items-center space-x-1">
                <%= nav_link_to "Dashboard", dashboard_path %>
                <%= nav_link_to "Agent Workspace", workspace_path %>
                <%= nav_link_to "Approval Center", approvals_path %>
                <%= nav_link_to "Policy Center", policies_path %>
                <%= nav_link_to "Audit Center", audit_path %>
                <%= nav_link_to "Evaluation Center", evaluations_path %>
              </nav>
            <% end %>

            <!-- User Session / Controls -->
            <div class="flex items-center space-x-3">
              <% if user_signed_in? && current_user %>
                <div class="hidden sm:flex flex-col text-right">
                  <span class="text-xs font-bold text-[#0d0726]"><%= current_user.name %></span>
                  <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider"><%= current_user.role %></span>
                </div>
                <div class="h-8 w-8 rounded-full bg-[#0d0726] text-[#d4f90d] flex items-center justify-center text-xs font-mono font-bold uppercase shadow-xs">
                  <%= current_user.name.first(2) %>
                </div>
                <%= button_to destroy_user_session_path, method: :delete, class: "text-xs font-semibold px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 transition cursor-pointer shadow-2xs" do %>
                  Sign out
                <% end %>
              <% else %>
                <%= link_to "Login", new_user_session_path, class: "text-xs font-bold px-3 py-1.5 text-slate-800 hover:text-black transition" %>
                <%= link_to "Sign up", new_user_registration_path, class: "text-xs font-bold px-4 py-2 rounded-lg bg-[#0d0726] hover:bg-black text-white transition shadow-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <!-- Global Notice / Alert Banners -->
      <%= render "shared/flash" %>

      <!-- Main Content Area with Retro-Tech Blueprint Grid -->
      <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
        <%= yield %>
      </main>

      <!-- Professional Governance Footer -->
      <footer class="mt-auto border-t border-slate-200 bg-[#eae8e1] py-6 text-xs text-slate-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center space-x-3">
            <div class="flex items-center space-x-2">
              <%= vaisastram_mascot_svg(classes: "w-5 h-5", variant: :dark) %>
              <span class="font-sans font-black text-slate-900">VAISASTRAM</span>
            </div>
            <span class="text-slate-400">|</span>
            <span class="text-slate-600 font-medium">Policy-Enforced Autonomous AI Agent Runtime</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono bg-white text-slate-800 border border-slate-300">v2.0</span>
          </div>
          <div class="flex items-center space-x-6 text-[11px] font-mono text-slate-600">
            <span class="flex items-center space-x-1.5">
              <span class="h-2 w-2 rounded-full bg-[#d4f90d] border border-black animate-pulse"></span>
              <span>Policy Guard: <strong class="text-slate-900">Enforcing</strong></span>
            </span>
            <span>Engine: <strong class="text-slate-900">Ruby 3.4.6 / Rails 8.1</strong></span>
            <span>DB: <strong class="text-slate-900">PostgreSQL</strong></span>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
