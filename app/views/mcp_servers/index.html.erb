<div class="space-y-10">
  <!-- Top Header & Metrics Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-dashed border-slate-300 pb-5 gap-3">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl font-black tracking-tight text-[#0d0726] font-sans">MCP Server Marketplace & Manager</h1>
        <span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded bg-[#0d0726] text-white">MCP 2024-11-05</span>
      </div>
      <p class="text-xs text-slate-600 mt-1 font-medium">
        Dynamic registration, tool discovery, and Ruby-governed execution for Model Context Protocol servers.
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <%= link_to new_mcp_server_path, class: "h-9 px-4 rounded-xl bg-[#0d0726] hover:bg-black text-white text-xs font-mono font-bold uppercase tracking-wider flex items-center space-x-1.5 transition shadow-xs hover:scale-102 active:scale-98 cursor-pointer" do %>
        <svg class="w-4 h-4 text-[#d4f90d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add MCP Server</span>
      <% end %>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-slate-300 p-4 shadow-2xs">
      <div class="text-[10px] font-mono uppercase text-slate-500 font-bold">Registered Servers</div>
      <div class="mt-1 flex items-baseline justify-between">
        <span class="text-2xl font-black text-[#0d0726] font-mono"><%= @servers.count %></span>
        <span class="text-xs font-mono text-slate-400">Total</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-300 p-4 shadow-2xs">
      <div class="text-[10px] font-mono uppercase text-slate-500 font-bold">Connected Servers</div>
      <div class="mt-1 flex items-baseline justify-between">
        <span class="text-2xl font-black text-emerald-700 font-mono"><%= @connected_count %></span>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-200">Live</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-300 p-4 shadow-2xs">
      <div class="text-[10px] font-mono uppercase text-slate-500 font-bold">Discovered Tools</div>
      <div class="mt-1 flex items-baseline justify-between">
        <span class="text-2xl font-black text-[#7c5cfc] font-mono"><%= @total_tools_count %></span>
        <span class="text-xs font-mono text-slate-400">Total Tools</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-300 p-4 shadow-2xs">
      <div class="text-[10px] font-mono uppercase text-slate-500 font-bold">Enabled & Governed</div>
      <div class="mt-1 flex items-baseline justify-between">
        <span class="text-2xl font-black text-slate-900 font-mono"><%= @enabled_tools_count %></span>
        <span class="text-xs font-mono text-slate-500">In Tool Registry</span>
      </div>
    </div>
  </div>

  <!-- SECTION 1: Configured Servers -->
  <div class="space-y-4">
    <div class="flex items-center justify-between border-b border-dashed border-slate-200 pb-2">
      <h2 class="text-sm font-black uppercase tracking-tight text-[#0d0726] font-sans">Active & Configured MCP Servers</h2>
      <span class="text-xs font-mono text-slate-500"><%= @servers.count %> <%= 'server'.pluralize(@servers.count) %></span>
    </div>

    <% if @servers.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <% @servers.each do |server| %>
          <div class="bg-white rounded-2xl border border-slate-300 shadow-2xs hover:shadow-sm transition p-5 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <!-- Top Row: Name and Transport Badge -->
              <div class="flex items-start justify-between gap-2">
                <div>
                  <h3 class="text-base font-bold text-[#0d0726] font-sans">
                    <%= link_to server.name, mcp_server_path(server), class: "hover:text-[#7c5cfc] transition" %>
                  </h3>
                  <span class="text-[10px] font-mono text-slate-400">id: <%= server.server_identifier %></span>
                </div>

                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase <%= server.stdio? ? 'bg-purple-50 text-purple-800 border border-purple-200' : 'bg-blue-50 text-blue-800 border border-blue-200' %>">
                  <%= server.transport_type.humanize %>
                </span>
              </div>

              <p class="text-xs text-slate-600 line-clamp-2">
                <%= server.description.presence || "No description provided." %>
              </p>

              <!-- Connection Status & Tools Count Pill -->
              <div class="flex flex-wrap items-center gap-2 pt-1">
                <% case server.status %>
                <% when "connected" %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-50 text-emerald-800 border border-emerald-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Connected</span>
                  </span>
                <% when "connecting" %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-50 text-blue-800 border border-blue-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                    <span>Connecting</span>
                  </span>
                <% when "failed" %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-rose-50 text-rose-800 border border-rose-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                    <span>Failed</span>
                  </span>
                <% else %>
                  <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-100 text-slate-700 border border-slate-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    <span><%= server.status.humanize %></span>
                  </span>
                <% end %>

                <span class="text-[10px] font-mono text-slate-500 px-2 py-0.5 rounded bg-slate-100">
                  <%= server.mcp_tools.count %> <%= 'tool'.pluralize(server.mcp_tools.count) %>
                  (<strong class="text-emerald-700"><%= server.mcp_tools.where(enabled: true).count %> enabled</strong>)
                </span>
              </div>
            </div>

            <!-- Footer: Quick Actions -->
            <div class="border-t border-slate-100 pt-3 flex items-center justify-between">
              <%= link_to "Manage Server →", mcp_server_path(server), class: "text-xs font-mono font-bold text-[#7c5cfc] hover:underline" %>

              <div class="flex items-center space-x-1.5">
                <% if server.connected? %>
                  <%= button_to "Disconnect", disconnect_mcp_server_path(server), method: :post, class: "px-2 py-1 text-[11px] font-mono rounded bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer" %>
                <% else %>
                  <%= button_to "Connect", connect_mcp_server_path(server), method: :post, class: "px-2 py-1 text-[11px] font-mono rounded bg-[#0d0726] hover:bg-black text-[#d4f90d] font-bold transition cursor-pointer" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-purple-50 text-[#7c5cfc] mx-auto flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-[#0d0726]">No MCP Servers Registered Yet</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto">
          Add a local STDIO subprocess or a remote Streamable HTTP MCP server, or choose one of the verified marketplace templates below.
        </p>
        <div class="pt-2">
          <%= link_to "Configure First MCP Server", new_mcp_server_path, class: "inline-flex items-center px-4 py-2 rounded-xl bg-[#0d0726] text-white text-xs font-mono font-bold hover:bg-black transition" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- SECTION 2: Marketplace Templates -->
  <div class="space-y-4 pt-6">
    <div class="flex items-center justify-between border-b border-dashed border-slate-200 pb-2">
      <div>
        <h2 class="text-sm font-black uppercase tracking-tight text-[#0d0726] font-sans">MCP Marketplace Directory</h2>
        <p class="text-[11px] text-slate-500">Verified integration templates ready for immediate configuration.</p>
      </div>
      <span class="text-xs font-mono text-slate-400"><%= @templates.size %> templates</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <% @templates.each do |tpl| %>
        <div class="bg-white rounded-2xl border border-slate-300 p-5 shadow-2xs hover:border-[#7c5cfc] transition space-y-4 flex flex-col justify-between">
          <div class="space-y-2.5">
            <div class="flex items-start justify-between">
              <div class="flex items-center space-x-2.5">
                <div class="h-9 w-9 rounded-xl bg-[#0d0726] text-[#d4f90d] flex items-center justify-center font-bold text-xs font-mono shrink-0">
                  <%= tpl[:key].first(2).upcase %>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-[#0d0726] font-sans"><%= tpl[:name] %></h3>
                  <span class="text-[10px] font-mono uppercase text-slate-400"><%= tpl[:category] %> · <%= tpl[:transport_type].upcase %></span>
                </div>
              </div>

              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-semibold border border-slate-200">
                Verified
              </span>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              <%= tpl[:description] %>
            </p>

            <div class="pt-1">
              <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block mb-1">Key Tools:</span>
              <div class="flex flex-wrap gap-1">
                <% tpl[:initial_tools].each do |tool| %>
                  <span class="text-[10px] font-mono bg-slate-50 border border-slate-200 text-slate-700 px-1.5 py-0.5 rounded">
                    <%= tool %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-mono text-slate-400">
              <%= tpl[:transport_type] == 'stdio' ? 'Child process' : 'HTTPS stream' %>
            </span>
            <%= link_to new_mcp_server_path(template: tpl[:key]), class: "px-3 py-1.5 rounded-lg bg-[#0d0726] hover:bg-black text-[#d4f90d] text-xs font-mono font-bold transition flex items-center space-x-1" do %>
              <span>Install Server</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
