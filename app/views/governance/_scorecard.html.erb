<div class="space-y-6">
  <!-- Header Info -->
  <div class="p-6 rounded-2xl bg-white border border-slate-300 shadow-2xs">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h3 class="text-lg font-black font-sans text-[#0d0726]">Governance Scorecard</h3>
        <p class="text-xs font-mono text-slate-500 mt-1">
          Rigorous mathematical accountability across 6 governance dimensions. No vanity metrics or synthetic placeholders.
        </p>
      </div>
      <div class="flex items-center space-x-2 text-xs font-mono">
        <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
          Window: <%= @scorecard[:time_label] %>
        </span>
      </div>
    </div>
  </div>

  <!-- 6 Dimension Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @scorecard[:dimensions].each do |dim| %>
      <div class="p-6 rounded-2xl bg-white border border-slate-300 shadow-2xs flex flex-col justify-between">
        <div>
          <!-- Header: Title and Status Badge -->
          <div class="flex items-start justify-between gap-2">
            <h4 class="text-sm font-bold font-sans text-[#0d0726]"><%= dim.title %></h4>
            <% status_class = case dim.status
               when :optimal then 'bg-emerald-100 text-emerald-800 border-emerald-200'
               when :acceptable then 'bg-blue-100 text-blue-800 border-blue-200'
               when :attention then 'bg-amber-100 text-amber-800 border-amber-200'
               else 'bg-slate-100 text-slate-600 border-slate-200'
               end %>
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase border <%= status_class %>">
              <%= dim.status %>
            </span>
          </div>

          <!-- Score Display -->
          <div class="mt-4 flex items-baseline space-x-2">
            <% if dim.available? %>
              <span class="text-4xl font-black font-sans text-[#0d0726]"><%= dim.formatted_score %></span>
            <% else %>
              <span class="text-2xl font-bold font-mono text-slate-400">Unavailable</span>
            <% end %>
          </div>

          <!-- Description -->
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            <%= dim.description %>
          </p>

          <!-- Mathematical Formula -->
          <div class="mt-4 p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-[11px] font-mono text-slate-700">
            <span class="text-slate-400 font-bold block text-[10px] uppercase tracking-wider mb-0.5">Formula</span>
            <code><%= dim.formula %></code>
          </div>

          <!-- Numerator & Denominator Breakdown -->
          <div class="mt-4 space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between text-slate-600">
              <span class="text-[11px] text-slate-500 truncate mr-2" title="<%= dim.numerator_label %>">Numerator: <%= dim.numerator_label %></span>
              <span class="font-bold text-slate-800 shrink-0"><%= dim.numerator %></span>
            </div>
            <div class="flex items-center justify-between text-slate-600">
              <span class="text-[11px] text-slate-500 truncate mr-2" title="<%= dim.denominator_label %>">Denominator: <%= dim.denominator_label %></span>
              <span class="font-bold text-slate-800 shrink-0"><%= dim.denominator %></span>
            </div>
          </div>
        </div>

        <!-- Footer: Source Records and Limitations -->
        <div class="mt-5 pt-4 border-t border-slate-100 space-y-1.5 text-[10px] font-mono text-slate-500">
          <div><span class="text-slate-400">Source:</span> <%= dim.source_records %></div>
          <div><span class="text-slate-400">Caveat:</span> <%= dim.data_limitations %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
