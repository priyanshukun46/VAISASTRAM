<div class="flex flex-wrap items-center justify-between gap-3 bg-white p-3.5 rounded-2xl border border-slate-300 shadow-2xs">
  <div class="flex items-center space-x-2">
    <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">Time Window:</span>
    <span class="text-xs font-mono font-bold text-[#0d0726] bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
      <%= @scope.range_label %>
    </span>
  </div>

  <div class="flex flex-wrap items-center gap-1.5">
    <% %w[24h 7d 30d all].each do |r| %>
      <% active = (@scope.range == r) %>
      <%= link_to governance_path(tab: @active_tab, range: r),
            class: "px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition #{active ? 'bg-[#0d0726] text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}" do %>
        <%= r.upcase %>
      <% end %>
    <% end %>

    <!-- Custom Range Form Toggle -->
    <details class="relative">
      <summary class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold cursor-pointer transition <%= @scope.range == 'custom' ? 'bg-[#0d0726] text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">
        CUSTOM...
      </summary>
      <div class="absolute right-0 mt-2 z-50 p-4 bg-white rounded-xl border border-slate-300 shadow-xl w-72">
        <%= form_with url: governance_path, method: :get, class: "space-y-3" do |f| %>
          <%= f.hidden_field :tab, value: @active_tab %>
          <%= f.hidden_field :range, value: "custom" %>
          <div>
            <%= f.label :start_date, "Start Date", class: "block text-[11px] font-mono text-slate-500 uppercase tracking-wider mb-1" %>
            <%= f.date_field :start_date, value: @scope.start_date || 7.days.ago.to_date, class: "w-full text-xs font-mono p-2 border border-slate-300 rounded-lg focus:ring-1 focus:ring-[#7c5cfc]" %>
          </div>
          <div>
            <%= f.label :end_date, "End Date", class: "block text-[11px] font-mono text-slate-500 uppercase tracking-wider mb-1" %>
            <%= f.date_field :end_date, value: @scope.end_date || Date.today, class: "w-full text-xs font-mono p-2 border border-slate-300 rounded-lg focus:ring-1 focus:ring-[#7c5cfc]" %>
          </div>
          <%= f.submit "Apply Filter", class: "w-full py-1.5 text-xs font-bold font-mono uppercase rounded-lg bg-[#0d0726] text-white hover:bg-black transition cursor-pointer" %>
        <% end %>
      </div>
    </details>
  </div>
</div>
