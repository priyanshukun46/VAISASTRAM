<h2 style="font-size: 20px; font-weight: 800; color: #0284c7; margin-top: 0;">Task Execution Started</h2>

<p style="color: #334155; font-size: 14px; margin-bottom: 20px;">
  The autonomous agent has started processing Task #<%= @task.id %>.
</p>

<div class="card-box">
  <table style="width: 100%; font-size: 13px; color: #334155;">
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b; width: 140px;">Task Title:</td>
      <td style="padding: 6px 0; font-weight: bold;"><%= @task.title %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b;">Assigned Agent:</td>
      <td style="padding: 6px 0;"><%= @agent.name %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b;">AI Provider / Model:</td>
      <td style="padding: 6px 0; font-family: monospace;"><%= @execution.provider %> / <%= @execution.ai_model %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: 600; color: #64748b;">Started At:</td>
      <td style="padding: 6px 0; font-family: monospace;"><%= @started_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></td>
    </tr>
  </table>
</div>

<p style="text-align: center; margin: 28px 0;">
  <%= link_to "Track Live Execution", timeline_execution_url(@execution), class: "button btn-accent" %>
</p>
