<div class="space-y-12" data-controller="workspace">
  <!-- Top Workspace Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-dashed border-slate-300 pb-5 gap-3">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl font-black tracking-tight text-[#0d0726] font-sans">Agent Workspace</h1>
        <span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded bg-[#0d0726] text-white">v2.0</span>
      </div>
      <p class="text-xs text-slate-600 mt-1 font-medium">
        Conversational task planning runtime with strict independent Ruby policy governance.
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#ccff00]/30 text-[#0d0726] border border-[#0d0726]">
        <span class="h-2 w-2 rounded-full bg-[#0d0726] animate-pulse"></span>
        <span>Policy Guard Active</span>
      </span>
    </div>
  </div>

  <!-- ACTIVE CONVERSATION & STRUCTURED PLAN SECTION -->
  <% if @active_task && @active_execution %>
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <div class="flex items-center space-x-2">
          <span class="text-xs font-mono font-bold uppercase text-slate-500">Active Session:</span>
          <span class="text-xs font-bold text-slate-900 font-mono">Task #<%= @active_task.id %></span>
          <span class="text-slate-300">|</span>
          <span class="text-xs text-slate-600"><%= @active_task.submitted_at.strftime("%b %d, %H:%M") %></span>
        </div>
        <div class="flex items-center space-x-2">
          <%= status_badge(@active_task.status) %>
        </div>
      </div>

      <!-- 1. Conversational Chat Interface -->
      <div class="bg-white rounded-2xl border border-slate-300 shadow-xs p-5 sm:p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-dashed border-slate-200 pb-3">
          <div class="flex items-center space-x-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-700">Governance Conversation Thread</span>
          </div>
          <span class="text-[11px] font-mono text-slate-400">AI proposes · Ruby decides</span>
        </div>

        <!-- User Message Bubble -->
        <div class="flex items-start justify-end space-x-3">
          <div class="max-w-xl bg-[#0d0726] text-white rounded-2xl rounded-tr-xs p-4 shadow-xs">
            <div class="flex items-center justify-between space-x-3 text-[11px] font-mono text-slate-400 mb-1">
              <span><%= current_user.name %> (Operator)</span>
              <span><%= @active_task.submitted_at.strftime("%H:%M") %></span>
            </div>
            <p class="text-sm font-medium leading-relaxed">
              <%= @active_task.instruction %>
            </p>
          </div>
          <div class="h-9 w-9 rounded-full bg-[#0d0726] text-[#d4f90d] flex items-center justify-center text-xs font-mono font-bold uppercase shrink-0 shadow-xs">
            <%= current_user.name.first(2) %>
          </div>
        </div>

        <!-- AI Agent Response Bubble -->
        <div class="flex items-start space-x-3">
          <div class="h-9 w-9 rounded-full bg-[#f4f3ef] border border-slate-300 flex items-center justify-center shrink-0 shadow-xs">
            <%= vaisastram_mascot_svg(classes: "w-6 h-6", variant: :dark) %>
          </div>
          <div class="max-w-2xl bg-[#faf9f5] border border-slate-300 rounded-2xl rounded-tl-xs p-5 shadow-xs space-y-3.5">
            <div class="flex items-center justify-between border-b border-dashed border-slate-200 pb-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-black uppercase tracking-tight text-[#0d0726]"><%= @active_task.agent.name.upcase %></span>
                <% if @active_execution.local_inference? && !@active_execution.fallback_used? %>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center space-x-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                    <span>LOCAL AI — <%= @active_execution.ai_model.upcase %></span>
                  </span>
                <% elsif @active_execution.fallback_used? %>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300 flex items-center space-x-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
                    <span>CLOUD FALLBACK — <%= @active_execution.provider.upcase %></span>
                  </span>
                <% else %>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 flex items-center space-x-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
                    <span><%= @active_execution.provider_badge_label %></span>
                  </span>
                <% end %>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">
                  <%= @active_execution.ai_model %>
                </span>
              </div>
              <div class="flex items-center space-x-2">
                <% if @active_execution.inference_duration.present? %>
                  <span class="text-[10px] font-mono text-slate-400" title="Inference Latency">
                    <%= @active_execution.inference_duration.round(0) %>ms
                  </span>
                  <span class="text-slate-300">·</span>
                <% end %>
                <span class="text-[10px] font-mono text-slate-500">
                  <%= @active_execution.completed_at ? @active_execution.completed_at.strftime("%H:%M") : "Just now" %>
                </span>
              </div>
            </div>

            <!-- Short, Human-Readable Response Text or Planning Failed Message -->
            <% if @active_execution.failed? %>
              <div class="space-y-3">
                <div class="flex items-center space-x-2 text-rose-700 font-bold font-mono text-xs uppercase">
                  <svg class="w-4 h-4 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                  <span>Planning failed</span>
                  <% if @active_execution.error_category.present? %>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-300">
                      <%= @active_execution.error_category %>
                    </span>
                  <% end %>
                </div>
                <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs font-mono text-rose-900 leading-relaxed">
                  <%= @active_execution.error_message.presence || "The AI model was unable to generate a valid execution plan." %>
                </div>
              </div>
            <% else %>
              <!-- Short, Human-Readable Response Text -->
              <% if @active_execution.ai_response_text.present? %>
                <div class="text-sm text-slate-800 leading-relaxed font-normal">
                  <%= format_ai_response(@active_execution.ai_response_text) %>
                </div>
              <% end %>

              <!-- Clarifying Questions Callout (if missing information) -->
              <% if @active_execution.clarification_needed? %>
                <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-xs space-y-1">
                  <div class="flex items-center space-x-1.5 font-bold uppercase font-mono text-[11px]">
                    <svg class="w-4 h-4 text-amber-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>Essential Information Missing:</span>
                  </div>
                  <p class="font-medium pl-5"><%= @active_execution.clarification_needed %></p>
                </div>
              <% end %>

              <!-- Explanation Callout (if unplannable request) -->
              <% if @active_execution.explanation_text.present? %>
                <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-300 text-rose-900 text-xs space-y-1">
                  <div class="flex items-center space-x-1.5 font-bold uppercase font-mono text-[11px]">
                    <svg class="w-4 h-4 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                    <span>Action Cannot Be Planned:</span>
                  </div>
                  <p class="font-medium pl-5"><%= @active_execution.explanation_text %></p>
                </div>
              <% end %>

              <!-- Prospective Language Assurance Badge -->
              <div class="pt-2 flex items-center space-x-2 text-[11px] font-mono text-slate-500 border-t border-dashed border-slate-200">
                <span class="h-2 w-2 rounded-full <%= @active_execution.conversation? ? 'bg-[#7c5cfc]' : 'bg-[#d4f90d]' %> border border-black"></span>
                <span>
                  <% if @active_execution.conversation? %>
                    Conversational inquiry. No tool actions required.
                  <% else %>
                    Actions are proposed only. Zero tools have been executed.
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Inline Conversation Reply Form (Chat Thread Continuity) -->
        <div class="pt-2 border-t border-dashed border-slate-200">
          <%= form_with url: workspace_path, method: :post, local: true, class: "flex items-center space-x-2" do |f| %>
            <%= f.hidden_field :ai_model, value: @selected_model %>
            <%= f.hidden_field :agent_id, value: @selected_agent&.id %>
            <%= f.hidden_field :parent_task_id, value: @active_task.id %>
            <%= f.text_field :instruction,
                  placeholder: "Reply to VAISASTRAM Agent (e.g. 'Can you add chords?', 'Make it shorter', 'Verify invoice INV-100')...",
                  class: "flex-1 rounded-xl bg-white border border-slate-300 px-4 py-2.5 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#7c5cfc] focus:border-transparent shadow-2xs" %>
            <%= f.button type: :submit, class: "h-10 px-4 rounded-xl bg-[#0d0726] hover:bg-black text-white text-xs font-mono font-bold uppercase tracking-wider flex items-center space-x-1.5 transition shadow-xs hover:scale-102 active:scale-98 cursor-pointer shrink-0" do %>
              <span>Reply</span>
              <svg class="w-3.5 h-3.5 text-[#d4f90d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- 2. Separately Displayed Structured Execution Plan -->
      <% if @active_execution.failed? %>
        <div class="bg-white rounded-2xl border border-rose-200 shadow-xs p-5 sm:p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-rose-100 pb-4 gap-2">
            <div>
              <div class="flex items-center space-x-2">
                <h2 class="text-base font-black uppercase tracking-tight text-[#0d0726]">Structured Execution Plan</h2>
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-rose-100 text-rose-800 font-bold border border-rose-300">
                  FAILED
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-1 font-medium">
                Category: <strong class="text-rose-900 font-mono"><%= @active_execution.error_category %></strong>
              </p>
            </div>
            <div class="flex items-center space-x-2">
              <span class="text-xs font-mono font-medium text-slate-500">
                0 actions planned on failure
              </span>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-center">
            <p class="text-xs font-mono text-slate-600">
              No execution steps were generated due to planning failure. Governed policies were not evaluated.
            </p>
          </div>
        </div>
      <% elsif @active_execution.action_plan? %>
        <div class="bg-white rounded-2xl border border-slate-300 shadow-xs p-5 sm:p-6 space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-dashed border-slate-200 pb-4 gap-2">
          <div>
            <div class="flex items-center space-x-2">
              <h2 class="text-base font-black uppercase tracking-tight text-[#0d0726]">Structured Execution Plan</h2>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-[#d4f90d] text-black font-bold border border-black">
                PROPOSED (UNEXECUTED)
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-1 font-medium">
              Goal: <strong class="text-slate-900"><%= @active_execution.plan["goal"].presence || @active_task.title %></strong>
            </p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-xs font-mono font-medium text-slate-500">
              <%= @active_execution.agent_steps.count %> <%= 'action'.pluralize(@active_execution.agent_steps.count) %> planned
            </span>
          </div>
        </div>

        <!-- Strict Governance Notice -->
        <div class="p-3.5 rounded-xl bg-[#f4f3ef] border border-slate-300 flex items-center space-x-3 text-xs text-slate-700">
          <div class="p-2 rounded-lg bg-[#0d0726] text-white shrink-0">
            <%= vaisastram_mascot_svg(classes: "w-4 h-4", variant: :light) %>
          </div>
          <div class="leading-relaxed font-medium">
            <strong>Policy Enforced Runtime:</strong> The steps below are purely proposals generated by the AI planner. In Phase 5, the independent Ruby policy engine will intercept and validate every parameter before tool invocation.
          </div>
        </div>

        <% if @active_execution.requires_action? && @active_execution.agent_steps.any? %>
          <!-- Step-by-Step Structured Cards (No Raw JSON) -->
          <div class="space-y-3 pt-2">
            <% @active_execution.agent_steps.each do |step| %>
              <div class="p-4 rounded-xl border border-slate-200 bg-[#faf9f5] hover:border-slate-300 transition duration-150 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div class="flex items-center space-x-3">
                    <span class="h-6 w-6 rounded-md bg-[#0d0726] text-[#d4f90d] font-mono text-xs font-bold flex items-center justify-center">
                      <%= sprintf("%02d", step.position) %>
                    </span>
                    <span class="font-mono text-sm font-bold text-[#7c5cfc]">
                      <%= step.action_key %>
                    </span>
                    <span class="text-xs text-slate-600 font-medium">
                      — <%= step.arguments["description"].presence || step.action_key.humanize %>
                    </span>
                  </div>

                  <div class="flex items-center space-x-2">
                    <%= status_badge(step.status) %>
                    <%= risk_badge(step.risk_level) %>
                  </div>
                </div>

                <!-- Structured Arguments Display (Chips, Not Raw JSON) -->
                <% if step.arguments.present? %>
                  <div class="pt-2 border-t border-dashed border-slate-200">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-bold block mb-1.5">
                      Proposed Arguments:
                    </span>
                    <div class="flex flex-wrap items-center gap-1.5">
                      <% step.arguments.each do |arg_key, arg_val| %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-white border border-slate-300 text-slate-800 shadow-2xs">
                          <strong class="text-slate-500 mr-1.5"><%= arg_key %>:</strong>
                          <span class="text-[#0d0726] font-semibold"><%= arg_val.is_a?(Hash) || arg_val.is_a?(Array) ? arg_val.to_s : arg_val %></span>
                        </span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <!-- No Steps Needed State -->
          <div class="text-center py-8 border border-dashed border-slate-300 rounded-xl bg-[#faf9f5]">
            <p class="text-xs font-medium text-slate-600 max-w-sm mx-auto">
              No tool action steps are scheduled for this instruction.
              <% if @active_execution.clarification_needed? %>
                Please provide the requested clarifying details above.
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
      <% end %>
    </div>
  <% end %>

  <!-- Hero Section: Signature UI (matches UX Pilot Reference Image 2) -->
  <div class="relative py-4 sm:py-6 text-center">
    <!-- Centered Robot Mascot with Scales of Justice -->
    <div class="flex justify-center mb-6">
      <div class="relative">
        <%= vaisastram_mascot_svg(classes: "w-20 h-20 transform hover:scale-105 transition duration-200 cursor-pointer", variant: :dark) %>
      </div>
    </div>

    <!-- Giant Headline -->
    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-[#0d0726] leading-none font-sans">
      AUTONOMOUS AGENTS<br/>
      <span class="bg-gradient-to-r from-[#7c5cfc] via-[#8b5cf6] to-[#a855f7] bg-clip-text text-transparent">
        WORTH BUILDING ON
      </span>
    </h2>

    <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-xl mx-auto font-medium">
      Autonomous multi-step planning governed by independent Ruby policies.<br class="hidden sm:inline" />
      AI proposes. Ruby decides. From prompt to policy-verified execution.
    </p>

    <!-- Signature Floating Prompt Input Box (Active Form Submitting to Workspace) -->
    <div class="mt-8 max-w-3xl mx-auto text-left">
      <%= form_with url: workspace_path, method: :post, local: true, class: "bg-white rounded-2xl border border-slate-300 shadow-sm hover:shadow-md transition duration-200 p-4 sm:p-5 relative" do |f| %>
        <%= f.label :instruction, "Task Instruction", class: "sr-only" %>
        <%= f.text_area :instruction,
          id: "workspace-prompt",
          data: { workspace_target: "prompt" },
          rows: 3,
          class: "w-full bg-transparent border-0 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:ring-0 focus:outline-none resize-none leading-relaxed",
          placeholder: "Ask a question, explain a concept, brainstorm ideas, or plan a task... (e.g. 'Explain Raft consensus' or 'Verify invoice INV-100 and prepare payment')" %>

        <!-- Bottom Toolbar inside input card -->
        <div class="flex items-center justify-between pt-3 border-t border-slate-100 mt-2 gap-2 sm:gap-4">
          <!-- Left tool icons -->
          <div class="flex items-center space-x-1.5 sm:space-x-2 text-slate-500 shrink-0 min-w-0">
            <button type="button" title="General & Domain Context" class="p-1.5 rounded-lg text-slate-400 hover:text-black hover:bg-slate-100 transition cursor-pointer shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
            </button>
            <button type="button" title="Allowlisted Domain Tools: lookup_invoice, verify_invoice, prepare_payment" class="p-1.5 rounded-lg text-slate-400 hover:text-black hover:bg-slate-100 transition cursor-pointer shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </button>
            <span class="inline-flex items-center space-x-1 text-[11px] font-mono text-slate-500 whitespace-nowrap shrink-0">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="hidden sm:inline">3 domain tools enabled</span>
              <span class="sm:hidden">3 tools</span>
            </span>
          </div>

          <!-- Right: Model selector & Action button -->
          <div class="flex items-center space-x-2 shrink-0">
            <!-- AI Selector: Just an arrow, no text -->
            <div class="relative flex items-center justify-center h-9 w-9 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 transition shadow-2xs hover:scale-102 active:scale-98 cursor-pointer shrink-0" title="Select AI Model (Current: <%= Ai::ModelCatalog.find(@selected_model)&.label || 'Auto' %>)">
              <svg class="w-4 h-4 text-emerald-800 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
              <%= f.label :ai_model, "AI model", class: "sr-only" %>
              <%= f.select :ai_model,
                    options_for_select(Ai::ModelCatalog.options_for_select, selected: @selected_model, disabled: Ai::ModelCatalog.disabled_ids),
                    {},
                    id: "ai-model-select",
                    class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer focus:ring-2 focus:ring-[#7c5cfc] focus:outline-none rounded-xl" %>
            </div>

            <%= f.button type: :submit,
              class: "h-9 px-3.5 rounded-xl bg-[#0d0726] hover:bg-black text-white flex items-center space-x-1.5 transition shadow-xs hover:scale-102 active:scale-98 cursor-pointer shrink-0",
              title: "Plan Execution with AI Planner" do %>
              <span class="text-xs font-bold uppercase tracking-wider font-mono">Plan</span>
              <svg class="w-3.5 h-3.5 text-[#d4f90d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Category / Suggestion Pills for Testing General-Purpose & Domain Scenarios -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto">
        <button
          type="button"
          data-action="click->workspace#setPrompt"
          data-prompt-text="Who are you and what is your governance architecture?"
