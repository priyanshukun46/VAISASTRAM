<!-- Right side showcase panel for Auth pages (matches UX Pilot reference design) -->
<div class="hidden lg:flex lg:w-1/2 bg-[#0d0726] bg-grid-blueprint-dark flex-col justify-between p-12 xl:p-16 text-white relative overflow-hidden border-l border-white/5">
