  <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-[#d4f90d]/10 blur-3xl pointer-events-none"></div>

  <!-- Top bar: Social Proof Badge -->
  <div class="flex items-center justify-end z-10">
    <div class="inline-flex items-center space-x-3 bg-white/5 backdrop-blur-sm border border-white/10 px-4 py-2 rounded-full shadow-inner">
