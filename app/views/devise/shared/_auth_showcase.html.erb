    <!-- Core Governance Pill Tagline -->
    <div class="mt-8 flex items-center space-x-3">
      <span class="h-2 w-2 rounded-full bg-[#d4f90d] animate-pulse"></span>
      <span class="text-xs font-mono uppercase tracking-widest text-slate-300">
        AI proposes · Ruby decides
      </span>
      <span class="text-slate-600">/</span>
      <span class="text-xs font-mono text-[#d4f90d]">
