        <span class="inline-block h-7 w-7 rounded-full ring-2 ring-[#0d0726] bg-gradient-to-br from-indigo-400 to-purple-600 text-[10px] font-bold flex items-center justify-center text-white">AK</span>
        <span class="inline-block h-7 w-7 rounded-full ring-2 ring-[#0d0726] bg-gradient-to-br from-emerald-400 to-teal-600 text-[10px] font-bold flex items-center justify-center text-white">SD</span>
        <span class="inline-block h-7 w-7 rounded-full ring-2 ring-[#0d0726] bg-gradient-to-br from-amber-400 to-orange-600 text-[10px] font-bold flex items-center justify-center text-white">ML</span>
        <span class="inline-block h-7 w-7 rounded-full ring-2 ring-[#0d0726] bg-gradient-to-br from-pink-400 to-rose-600 text-[10px] font-bold flex items-center justify-center text-white">RH</span>
      </div>
      <span class="text-xs font-medium text-slate-200">Trusted by 1M+ users</span>
    </div>
  </div>

  <!-- Center: Giant Signature Stroked Display Typography -->
  <div class="my-auto py-12 z-10 select-none">
    <div class="space-y-1 font-sans font-black tracking-tighter uppercase text-6xl xl:text-7xl 2xl:text-8xl leading-none">
