        <span class="text-white drop-shadow-sm">MOVE</span>
        <span class="text-stroke-white tracking-normal font-outline">FAST</span>
      </div>
      <div class="flex items-baseline space-x-4">
        <span class="text-stroke-white tracking-normal">THINK</span>
        <span class="text-stroke-white tracking-normal">CLEAR</span>
      </div>
      <div class="flex items-baseline space-x-4">
        <span class="text-stroke-white tracking-normal">GOVERN</span>
        <span class="text-white drop-shadow-sm">SMART</span>
      </div>
