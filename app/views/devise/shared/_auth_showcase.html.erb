        <span class="text-sm font-black text-[#e20074] tracking-tight">T · Mobile</span>
      </div>

      <!-- HubSpot -->
      <div class="flex items-center justify-center space-x-1">
        <span class="text-xs font-bold text-[#ff7a59] tracking-tight">HubSp<span class="text-white">o</span>t</span>
      </div>
    </div>
