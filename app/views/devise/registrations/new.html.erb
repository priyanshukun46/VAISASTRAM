<div class="min-h-screen w-full flex flex-col lg:flex-row bg-[#f4f3ef]">
  <!-- Left Column: Sign Up Form (matches UX Pilot Reference Image 4) -->
  <div class="w-full lg:w-1/2 flex flex-col justify-between p-6 sm:p-10 lg:p-14 xl:p-18 bg-[#f4f3ef] border-r border-slate-200">
    <!-- Top brand mark -->
    <div class="flex items-center space-x-3 mb-6">
      <%= link_to root_path, class: "flex items-center group" do %>
        <%= vaisastram_logo_svg(classes: "h-9 w-auto group-hover:opacity-85 transition", variant: :dark) %>
      <% end %>
    </div>

    <!-- Centered Form Container -->
    <div class="max-w-md w-full mx-auto my-auto py-4">
      <div class="mb-6">
        <h1 class="text-3xl font-black uppercase tracking-tight text-[#0d0726]">SIGN UP</h1>
        <p class="text-xs text-slate-600 mt-1.5 font-medium">Create your free VAISASTRAM account.</p>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Form -->
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-3.5 mt-2" }) do |f| %>
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider mb-1.5" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Full Name", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition shadow-2xs" %>
        </div>

        <div>
          <%= f.label :email, "Email Address", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider mb-1.5" %>
          <%= f.email_field :email, autocomplete: "email", placeholder: "Email", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition shadow-2xs" %>
        </div>


        <div>
          <%= f.label :password, "Password", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider mb-1.5" %>
          <div class="relative">
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password (min 6 characters)", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition pr-10 shadow-2xs" %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
          </div>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm Password", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition shadow-2xs" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Create Account", class: "w-full py-3 px-4 rounded-lg bg-[#d4f90d] hover:bg-[#c6ec00] active:scale-[0.99] text-black font-black text-sm uppercase tracking-wider border border-black shadow-xs transition duration-150 cursor-pointer text-center" %>
        </div>
      <% end %>

      <!-- Links -->
      <div class="mt-6 text-center space-y-3">
        <div class="text-xs text-slate-700">
          Already have an account? <%= link_to "LOGIN HERE", new_session_path(resource_name), class: "font-black underline text-black hover:text-[#7c5cfc]" %>
        </div>

        <p class="text-[11px] text-slate-500 leading-relaxed max-w-sm mx-auto">
          By signing up for VAISASTRAM account, you agree to our <strong class="text-slate-800">Privacy Policy</strong> and <strong class="text-slate-800">Terms of Service</strong>.
        </p>
      </div>
    </div>

    <!-- Bottom note -->
    <div class="text-center text-[11px] text-slate-400">
      VAISASTRAM AI Governance Platform · Secure Session Authentication
    </div>
  </div>

  <!-- Right Column: Visual Showcase -->
  <%= render "devise/shared/auth_showcase" %>
</div>
