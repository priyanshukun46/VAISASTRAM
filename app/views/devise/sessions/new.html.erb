<div class="min-h-screen w-full flex flex-col lg:flex-row bg-[#f4f3ef]">
  <!-- Left Column: Sign In Form (matches UX Pilot Reference Image 5) -->
  <div class="w-full lg:w-1/2 flex flex-col justify-between p-6 sm:p-10 lg:p-14 xl:p-18 bg-[#f4f3ef] border-r border-slate-200">
    <!-- Top brand mark -->
    <div class="flex items-center space-x-3 mb-6">
      <%= link_to root_path, class: "flex items-center group" do %>
        <%= vaisastram_logo_svg(classes: "h-9 w-auto group-hover:opacity-85 transition", variant: :dark) %>
      <% end %>
    </div>

    <!-- Centered Form Container -->
    <div class="max-w-md w-full mx-auto my-auto py-4">
      <div class="mb-6">
        <h1 class="text-3xl font-black uppercase tracking-tight text-[#0d0726]">WELCOME BACK</h1>
        <p class="text-xs text-slate-600 mt-1.5 font-medium">Log in to your account to continue.</p>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Direct Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4 mt-2" }) do |f| %>
        <div>
          <%= f.label :email, "Email address", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition shadow-2xs" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Password", class: "block text-xs font-mono uppercase text-slate-700 tracking-wider" %>
          </div>
          <div class="relative">
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "w-full px-3.5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:border-[#7c5cfc] focus:ring-2 focus:ring-[#7c5cfc]/20 focus:outline-none transition pr-10 shadow-2xs" %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center space-x-2 pt-0.5">
            <%= f.check_box :remember_me, class: "h-3.5 w-3.5 rounded border-slate-300 text-[#0d0726] focus:ring-[#7c5cfc]" %>
            <%= f.label :remember_me, "Keep me logged in on this browser", class: "text-xs text-slate-600 select-none" %>
          </div>
        <% end %>

        <div class="pt-2">
          <%= f.submit "Login", class: "w-full py-3 px-4 rounded-lg bg-red-600 hover:bg-red-700 active:scale-[0.99] text-white font-black text-sm uppercase tracking-wider border border-red-700 shadow-xs transition duration-150 cursor-pointer text-center" %>
        </div>
      <% end %>

      <!-- Links matching UX Pilot screen -->
      <div class="mt-6 text-center space-y-3">
        <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
          <div>
            <%= link_to "Forgot Password?", new_password_path(resource_name), class: "text-xs text-slate-600 hover:text-black font-medium transition" %>
          </div>
        <% end %>

        <div class="text-xs text-slate-700">
          Don't have an account? <%= link_to "SIGN UP HERE", new_registration_path(resource_name), class: "font-black underline text-black hover:text-[#7c5cfc]" %>
        </div>

        <div class="pt-3 border-t border-dashed border-slate-300 text-[11px] font-mono text-slate-500">
          Default Seed: <span class="text-black font-semibold">admin@vaisastram.internal</span> / <span class="text-black font-semibold">vaisastram2026</span>
        </div>
      </div>
    </div>

    <!-- Bottom note -->
    <div class="text-center text-[11px] text-slate-400">
      VAISASTRAM AI Governance Platform · Secure Session Authentication
    </div>
  </div>

  <!-- Right Column: Visual Showcase -->
  <%= render "devise/shared/auth_showcase" %>
</div>
