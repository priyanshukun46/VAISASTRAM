<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-dashed border-slate-300 pb-5 gap-3">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl font-black tracking-tight text-[#0d0726] font-sans">Evaluation Center</h1>
        <span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded bg-[#0d0726] text-white">BENCHMARKS</span>
      </div>
      <p class="text-xs text-slate-600 mt-1 font-medium">
        Deterministic Ruby governance test suite, mathematical scorecards, and live benchmark execution.
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <%= link_to governance_path(tab: "scorecard"), class: "px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" do %>
        View Scorecard →
      <% end %>
      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#7c5cfc]/15 text-[#7c5cfc] border border-[#7c5cfc]/30">
        <span class="h-2 w-2 rounded-full bg-[#7c5cfc] animate-pulse"></span>
        <span>20 Deterministic Test Cases</span>
      </span>
    </div>
  </div>

  <%= render "governance/evaluations" %>
</div>
